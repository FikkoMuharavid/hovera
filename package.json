{
    "name":  "hovera",
    "version":  "1.0.5",
    "description":  "Hovera - Dynamic Productivity Hub for Windows",
    "author":  "Fikko Muharavid \u003chttps://github.com/FikkoMuharavid\u003e",
    "license":  "MIT",
    "repository":  {
                       "type":  "git",
                       "url":  "https://github.com/FikkoMuharavid/hovera.git"
                   },
    "homepage":  "https://github.com/FikkoMuharavid/hovera#readme",
    "type":  "module",
    "main":  "electron/main.cjs",
    "scripts":  {
                    "dev:vite":  "vite",
                    "dev:electron":  "wait-on tcp:5173 \u0026\u0026 cross-env NODE_ENV=development electron .",
                    "dev":  "concurrently -k \"npm run dev:vite\" \"npm run dev:electron\"",
                    "build":  "tsc -b \u0026\u0026 vite build",
                    "dist":  "npm run build \u0026\u0026 electron-builder --win nsis -c.npmRebuild=false",
                    "dist:installer":  "npm run build \u0026\u0026 electron-builder --win nsis -c.npmRebuild=false",
                    "dist:portable":  "npm run build \u0026\u0026 electron-builder --win portable -c.npmRebuild=false",
                    "dist:all":  "npm run build \u0026\u0026 electron-builder --win nsis portable -c.npmRebuild=false",
                    "start":  "electron .",
                    "lint":  "oxlint",
                    "preview":  "vite preview",
                    "tauri":  "tauri",
                    "tauri:dev":  "tauri dev",
                    "tauri:build":  "tauri build"
                },
    "dependencies":  {
                         "@tauri-apps/api":  "^2.12.4",
                         "@xenova/transformers":  "^2.17.2"
                     },
    "devDependencies":  {
                            "@tailwindcss/vite":  "^4.3.3",
                            "@types/canvas-confetti":  "^1.9.0",
                            "@types/node":  "^24.19.2",
                            "@types/react":  "^19.3.0",
                            "@types/react-dom":  "^19.3.0",
                            "@vitejs/plugin-react":  "^6.1.2",
                            "canvas-confetti":  "^1.9.4",
                            "clsx":  "^2.1.1",
                            "concurrently":  "^10.0.6",
                            "cross-env":  "^10.1.0",
                            "electron":  "^33.4.11",
                            "electron-builder":  "^26.15.3",
                            "framer-motion":  "^14.6.0",
                            "lucide-react":  "^1.61.0",
                            "oxlint":  "^1.88.0",
                            "react":  "^19.3.1",
                            "react-dom":  "^19.3.1",
                            "tailwind-merge":  "^3.7.0",
                            "tailwindcss":  "^4.3.3",
                            "typescript":  "~6.0.3",
                            "vite":  "^8.3.4",
                            "wait-on":  "^9.5.1"
                        }
}